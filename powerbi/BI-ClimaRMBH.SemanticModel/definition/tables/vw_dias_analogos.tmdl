		dataType: dateTime
		formatString: General Date
		lineageTag: 14ff4634-6028-4e49-b1e1-f779490b8c45
		summarizeBy: none
		sourceColumn: dt_calculo

		variation Variation
			isDefault
			relationship: ba0b3307-98e8-410e-bd26-f4652f790dcb
			defaultHierarchy: LocalDateTable_12ec61c1-f72b-4e5d-8df8-407d4042074e.'Hierarquia de datas'

		annotation SummarizationSetBy = Automatic

	column 'Dia previsto' =
			
			VAR antecedencia = vw_dias_analogos[antecedencia_dias]
			RETURN
			    SWITCH (
			        antecedencia,
			        0, "Hoje",
			        1, "Amanhã",
			        LOWER ( LEFT ( RELATED ( vw_data[nome_dia_semana] ), 3 ) ) & " " & FORMAT ( RELATED ( vw_data[dia] ), "00" )
			    )
		lineageTag: ae4fea57-3554-48d2-bf29-0d6b6ad72ba5
		summarizeBy: none
		sortByColumn: antecedencia_dias

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column 'Década análogo' = INT ( vw_dias_analogos[ano_analogo] / 10 ) * 10
		formatString: 0
		lineageTag: b12590be-e97d-441d-8e92-bd2a11a4d130
		summarizeBy: none

		annotation SummarizationSetBy = User

	partition vw_dias_analogos = m
		mode: import
