				let
				    Fonte = Sql.Database(Servidor, "ClimaRMBH"),
				    bi_vw_dias_analogos = Fonte{[Schema="bi",Item="vw_dias_analogos"]}[Data]
				in
				    bi_vw_dias_analogos

