table vw_dias_analogos
	lineageTag: f5a0a379-271b-45cd-920a-103ce8b6be7e

	measure Análogos = COUNTROWS ( vw_dias_analogos )
		formatString: 0
		lineageTag: 8f0b9f4d-76db-43d7-b471-c05090c06e4e

	measure 'Análogos com chuva depois' = CALCULATE ( [Análogos], vw_dias_analogos[dias_com_chuva_3_dias] >= 1 )
		formatString: 0
		lineageTag: 5d28d25d-a0f6-477f-802a-8462ef6f700b

	measure 'Choveu depois' = FORMAT ( [Análogos com chuva depois] + 0, "0" ) & " de " & FORMAT ( [Análogos], "0" )
		lineageTag: 270697f3-17f9-402d-9b3f-668c9b472b84

	measure 'Chuva média depois' = AVERAGE ( vw_dias_analogos[chuva_3_dias] )
		formatString: 0.0" mm"
		lineageTag: 50645729-733c-482e-827c-af323af0f581

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Análogo mais parecido' = FORMAT ( CALCULATE ( MIN ( vw_dias_analogos[data_analogo] ), vw_dias_analogos[posicao] = 1 ), "dd/mm/yyyy" )
		lineageTag: c351420e-c075-4dca-b725-88b7c5d5765c

	measure 'Distância mais parecido' = CALCULATE ( MIN ( vw_dias_analogos[distancia] ), vw_dias_analogos[posicao] = 1 )
		formatString: 0.00
		lineageTag: 800afedb-09f3-4654-92a7-0e5f6ff5c729

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Titulo Analogos' =
			
			"Dias parecidos com "
			    & LOWER ( SELECTEDVALUE ( vw_dias_analogos[Dia previsto], "os próximos dias" ) )
			    & " em " & SELECTEDVALUE ( vw_municipio[nome], "selecione um município" )
		lineageTag: a8135ad9-f705-4eb6-a6b2-8370b8bcc291

	measure 'Subtitulo Analogos' =
			
			VAR dia = SELECTEDVALUE ( vw_dias_analogos[data_id] )
			VAR maxima = CALCULATE ( MAX ( vw_previsao_dia[temperatura_2m_max] ), vw_previsao_dia[data_id] = dia )
			VAR minima = CALCULATE ( MAX ( vw_previsao_dia[temperatura_2m_min] ), vw_previsao_dia[data_id] = dia )
			VAR chuva = CALCULATE ( MAX ( vw_previsao_dia[precipitacao_total] ), vw_previsao_dia[data_id] = dia )
			RETURN
			    IF (
			        ISBLANK ( dia ),
			        "Escolha um dia para ver a previsão e os 10 dias mais parecidos",
			        "10 dias mais próximos da previsão em 86 anos, um por ano · previsto: máx "
			            & FORMAT ( maxima, "0" ) & " °C · mín " & FORMAT ( minima, "0" ) & " °C · "
			            & FORMAT ( chuva, "0.0" ) & " mm"
			    )
		lineageTag: 351fa47e-9d53-471e-b3b8-b35b45f97f22

