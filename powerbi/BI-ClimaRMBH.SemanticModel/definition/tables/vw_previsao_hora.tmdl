	column 'Próximas 48h' =
			
			VAR agora = MAX ( vw_condicao_atual[data_hora_local] )
			RETURN
			    vw_previsao_hora[data_hora_local] >= agora
			        && vw_previsao_hora[data_hora_local] < agora + 2
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 1c48c21a-4db3-4f3d-9bcb-7f0f9a70f428
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

